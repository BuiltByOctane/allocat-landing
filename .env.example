# Anonymous funnel beacon endpoint on allocat-web. Counts page views and CTA
# clicks with no cookies, ids or third-party scripts. Unset ⇒ no tracking at all.
VITE_TRACK_ENDPOINT=https://allocat.xyz/api/track

# iOS waitlist signup endpoint on allocat-web. Defaults to the production URL when unset.
VITE_WAITLIST_ENDPOINT=https://allocat.xyz/api/waitlist
